---
import userConfig from 'virtual:starlight-theme-six-config';
import { getRelativeLocaleUrl } from 'astro:i18n';
import AtlasSidebarSublist from './AtlasSidebarSublist.astro';

const { siteTitleHref, sidebar } = Astro.locals.starlightRoute;
---

<div popover="auto" id="drawer" class="atlas-drawer">
  <button class="sheet-overlay" popovertarget="drawer" popovertargetaction="hide" aria-label="Close navigation menu"></button>
  <div class="content">
    <div class="header">
      <button class="drag-icon" popovertarget="drawer" popovertargetaction="hide" aria-label="Close navigation menu"><span></span></button>
    </div>
    <div class="body">
      <div class="links-nav">
        <a href={siteTitleHref}>{Astro.locals.t('six.home')}</a>
        {
          userConfig.navLinks?.map((nav) => {
            const absoluteLinkRegex = /^https?:\/\//;
            const link =
              !absoluteLinkRegex.test(nav.link) && Astro.currentLocale
                ? getRelativeLocaleUrl(Astro.currentLocale, nav.link)
                : nav.link;
            const label =
              typeof nav.label === 'string'
                ? nav.label
                : (nav.label[Astro.currentLocale ?? 'en'] ?? Object.values(nav.label)[0] ?? nav.link);

            return (
              <a href={link} {...nav.attrs}>
                {label}
                {nav.badge && <span class="badge">{nav.badge}</span>}
              </a>
            );
          })
        }
      </div>

      <nav class="links-docs" aria-label="Atlas mobile navigation">
        <AtlasSidebarSublist sublist={sidebar} depth={0} />
      </nav>
    </div>
  </div>
</div>

<style>
  button {
    all: unset;
  }

  [popover] {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    display: flex;
    opacity: 0;
    pointer-events: none;
    align-items: center;
    flex-direction: column;
    justify-content: flex-end;
    transition: 0.1s linear;
    z-index: 1000;
    background: transparent;
    border: none;
  }

  [popover]::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }

  [popover]:popover-open {
    opacity: 1;
    pointer-events: auto;
  }

  [popover]:popover-open .content {
    transform: translateY(0%);
  }

  .sheet-overlay {
    position: fixed;
    top: 0;
    left: 0;
    z-index: -1;
    width: 100vw;
    height: 100vh;
    opacity: 0.1;
    background-color: transparent;
  }

  .content {
    width: 100%;
    position: relative;
    background: var(--background);
    max-height: 85vh;
    height: 75vh;
    max-width: 1150px;
    transform: translateY(100%);
    border-radius: 12px 12px 0 0;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    transition: 0.25s ease;
    display: flex;
    flex-direction: column;
  }

  .header {
    display: flex;
    justify-content: center;
    flex-shrink: 0;
  }

  .header .drag-icon span {
    height: 0.15rem;
    width: 64px;
    display: block;
    background-color: var(--muted-foreground);
    border-radius: 9999px;
    margin-top: 0.75rem;
  }

  .body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 1rem 1.25rem 2rem;
  }

  .links-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 0.9rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .links-nav a {
    font-size: 0.9rem;
    line-height: 1.4;
    color: inherit;
    text-decoration: none;
    font-weight: 500;
  }

  .links-docs {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .badge {
    padding: 0.125rem 0.375rem;
    margin-left: 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    line-height: 1;
    font-weight: 400;
    text-decoration: none;
    background: #adfa1d;
    color: #000000;
  }
</style>
