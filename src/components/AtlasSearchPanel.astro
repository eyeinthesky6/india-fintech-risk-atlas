---
import StarlightBanner from '@astrojs/starlight/components/Banner.astro';
import ContentPanel from '@six-tech/starlight-theme-six/overrides/ContentPanel.astro';
import config from 'virtual:starlight/user-config';
import '@pagefind/default-ui/css/ui.css';
---

<StarlightBanner />

{config.pagefind && (
  <section id="atlas-search-panel" aria-labelledby="atlas-search-title" data-pagefind-ignore hidden>
    <ContentPanel>
      <div class="search-panel">
        <div class="search-heading">
          <h2 id="atlas-search-title">Search the Atlas</h2>
          <button type="button" data-search-close>Close search</button>
        </div>
        <p role="status" data-search-status></p>
        <div id="atlas-search-results"></div>
      </div>
    </ContentPanel>
  </section>
)}

<script>
  import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';

  const trigger = document.querySelector<HTMLButtonElement>('#atlas-search-button');
  const panel = document.querySelector<HTMLElement>('#atlas-search-panel');
  const close = panel?.querySelector<HTMLButtonElement>('[data-search-close]');
  const status = panel?.querySelector<HTMLElement>('[data-search-status]');
  const results = document.querySelector<HTMLElement>('#atlas-search-results');

  if (trigger && panel && close && status && results) {
    let returnScroll = 0;
    let initialize: Promise<void> | undefined;

    if (/Mac|iPhone|iPad/.test(navigator.platform)) {
      trigger.querySelector('kbd')!.textContent = '⌘ K';
    }

    const hide = (restorePosition = true) => {
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (restorePosition) {
        trigger.focus({ preventScroll: true });
        window.scrollTo(0, returnScroll);
      }
    };

    const show = async () => {
      returnScroll = window.scrollY;
      panel.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      panel.scrollIntoView({ block: 'start' });
      close.focus({ preventScroll: true });

      if (import.meta.env.DEV) {
        status.textContent = 'Search is available in the built site preview.';
        return;
      }

      if (!initialize) {
        status.textContent = 'Loading search…';
        initialize = import('@pagefind/default-ui').then(({ PagefindUI }) => {
          const baseUrl = import.meta.env.BASE_URL;
          new PagefindUI({
            ...pagefindUserConfig,
            element: '#atlas-search-results',
            baseUrl,
            bundlePath: `${baseUrl.replace(/\/$/, '')}/pagefind/`,
            showImages: false,
            showSubResults: true,
          });
          status.textContent = '';
        });
      }

      try {
        await initialize;
        if (!panel.hidden && document.activeElement === close) {
          results.querySelector('input')?.focus({ preventScroll: true });
        }
      } catch {
        initialize = undefined;
        status.textContent = 'Search couldn’t load. Close and reopen search to try again.';
      }
    };

    const toggle = () => {
      if (panel.hidden) void show();
      else hide();
    };

    trigger.addEventListener('click', toggle);
    trigger.disabled = false;
    close.addEventListener('click', () => hide());

    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.repeat) return;
      const shortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
      const escape = event.key === 'Escape' && !panel.hidden
        && event.target instanceof Node && (event.target === trigger || panel.contains(event.target));
      if (shortcut || escape) {
        event.preventDefault();
        event.stopPropagation();
        toggle();
      }
    }, { capture: true });

    results.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.target.closest('a');
      if (link?.hash && link.pathname === location.pathname) hide(false);
    });
  }
</script>

<style>
  .search-panel {
    --pagefind-ui-primary: var(--sl-color-text-accent);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--muted);
    --pagefind-ui-font: inherit;
    --pagefind-ui-scale: 0.875;
    padding: clamp(1rem, 3vw, 1.5rem);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
  }

  .search-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: 0.75rem;
  }

  h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }

  button {
    color: var(--muted-foreground);
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    font: inherit;
    font-size: 0.8125rem;
    padding: 0.375rem 0.625rem;
    cursor: pointer;
  }

  button:hover {
    color: var(--foreground);
  }

  [data-search-status]:empty {
    margin: 0;
  }

  #atlas-search-results {
    overflow-wrap: anywhere;
  }
</style>
